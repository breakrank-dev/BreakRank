# Data — never commit
data/
*.csv
*.tar.gz
*.zip
!tests/fixtures/*.csv
!data/.gitkeep

# The fixer's bundle is built on the machine that has data/ (python
# scripts/build_bundle.py); whether a copy is committed is open (NOTES §38.13)
fixer/data/*.sqlite

# Models — only the current one
artifacts/*
!artifacts/ranker.txt
!artifacts/.gitkeep

# Secrets
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Node
node_modules/
.next/
.vercel/

# OS
.DS_Store
Thumbs.db