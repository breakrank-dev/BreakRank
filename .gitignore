# Data — never commit
data/
*.csv
*.tar.gz
*.zip
!tests/fixtures/*.csv
!data/.gitkeep

# The fixer's bundle (fixer/data/breakrank.sqlite) IS committed, one copy,
# rebuilt only when the dataset changes (python scripts/build_bundle.py;
# NOTES §38.13). `data/` above matches any folder named data, so the
# fixer's is let back in here.
!fixer/data/

# Models — only the current one
artifacts/*
!artifacts/ranker.txt
!artifacts/.gitkeep

# Secrets
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Node
node_modules/
.next/
.vercel/

# OS
.DS_Store
Thumbs.dblogs/
