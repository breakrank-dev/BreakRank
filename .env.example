# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit the real one. Not once, not "temporarily."
#
#   cp .env.example .env
#
# Then open .env in a text editor and paste your real values in.

# Neon Postgres connection string (teammate creates this on day 1).
# Looks like: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# GitHub personal access token. NOT needed on day 1 — leave it blank.
# First used in week 5, when you start fetching changelogs from the GitHub API.
# Without one you get 60 API requests/hour. With one, 5,000.
#
# Create at: https://github.com/settings/personal-access-tokens
#   Generate new token -> Repository access: "Public Repositories"
#   -> leave every permission on "No access" -> Generate token
# ("Developer settings" is not something you sign up for. Every account has it,
#  at the very bottom of the Settings sidebar. The link above skips the hunt.)
GITHUB_TOKEN=

# Hugging Face token (needed from week 5, when you deploy the API).
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=
